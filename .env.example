# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# GITHUB_PAT: Personal Access Token with 'repo' and 'workflow' scopes to trigger repository_dispatch.
GITHUB_PAT="MY_GITHUB_PAT"

# GITHUB_OWNER: GitHub organization or username hosting the Android WebView template repository.
GITHUB_OWNER="medianforge-org"

# GITHUB_REPO: Repository name containing .github/workflows/build-apk.yml and the Kotlin template.
GITHUB_REPO="android-webview-builder"

# WEBHOOK_SECRET: Shared secret token sent in X-Webhook-Secret header from GitHub Actions to /api/github-webhook.
WEBHOOK_SECRET="MY_WEBHOOK_SECRET"
